#============================
# RADIOACTIVE DECAY TEST
#============================

# Particle: K-40 (Z=19, A=40, I=0)
/gps/particle ion
/gps/ion 19 40 0

# Energy: small non-zero to trigger step
/gps/energy 0 keV

# Position: inside volume "camera"
/gps/pos/type Volume
/gps/pos/confine camera
/gps/pos/shape Para
/gps/pos/centre 78.5 0. 0. cm
/gps/pos/halfx 30 cm
/gps/pos/halfy 30 cm
/gps/pos/halfz 30 cm

# Direction (any, e.g., +x)
/gps/direction 1 0 0

# Physics: radioactive decay enabled
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year

/run/initialize
# Verbose for tracking steps
/run/verbose 0
/event/verbose 0
/tracking/verbose 1

# Output file
/CYGNO/outfile K40_test

# Seeds (optional)
/random/setSeeds 12345 67890

# Generate 1 event
/run/beamOn 1000

